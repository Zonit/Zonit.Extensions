<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Project (catalog) services for Zonit applications. Provides ICatalogProvider (the active project and the visible project list as read-only Project value objects), ICatalogManager (per-scope catalog state and project switching) and IProjectSource, the contract your app implements to supply the data. Framework-agnostic: no HttpContext and no middleware here - the ASP.NET Core middleware that hydrates the scope ships in Zonit.Extensions.Website. Built on top of Zonit.Extensions value objects (Project).</Description>
    <PackageTags>Zonit;Extensions;Projects;Catalogs;Workspaces</PackageTags>
  </PropertyGroup>

  <!--
    Framework-agnostic dependencies — Projects core only declares contracts and a
    catalog state machine, no HttpContext. ProjectMiddleware lives in
    Zonit.Extensions.Website and is wired through UseWebsite().
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zonit.Extensions\Zonit.Extensions.csproj" />
  </ItemGroup>
</Project>
