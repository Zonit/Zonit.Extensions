<Project Sdk="Microsoft.NET.Sdk.Razor">
<PropertyGroup>
  <!-- Package Metadata -->
  <Description>ASP.NET Core and Blazor web extensions providing base components (PageBase, PageEditBase, PageViewBase), navigation services, breadcrumbs management, toast notifications, cookie handling, and data protection utilities for building modern web applications.</Description>
  <PackageTags>Zonit;Extensions;Blazor;AspNetCore;Navigation;Breadcrumbs;Toasts;Cookies;Components;Web</PackageTags>
</PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- All four legacy NuGet *.Abstractions packages have been consolidated (E2-E5)
         into in-tree projects under ../Zonit.Extensions.{Cultures,Auth,Organizations,Projects}.
         The legacy NuGet packages are no longer referenced. -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zonit.Extensions\Zonit.Extensions.csproj" />
    <!--
      Only the builder-level AddWebsite overload uses this: configuration sources have to be in
      place before Build(), which an IServiceCollection extension cannot arrange. Hosts that
      manage their own configuration ladder can keep calling services.AddWebsite() and never
      touch it.
    -->
    <ProjectReference Include="..\Zonit.Extensions.Configuration\Zonit.Extensions.Configuration.csproj" />
    <ProjectReference Include="..\Zonit.Extensions.Cultures\Zonit.Extensions.Cultures.csproj" />
    <ProjectReference Include="..\Zonit.Extensions.Auth\Zonit.Extensions.Auth.csproj" />
    <ProjectReference Include="..\Zonit.Extensions.Organizations\Zonit.Extensions.Organizations.csproj" />
    <ProjectReference Include="..\Zonit.Extensions.Projects\Zonit.Extensions.Projects.csproj" />
    <ProjectReference Include="..\Zonit.Extensions.Tenants\Zonit.Extensions.Tenants.csproj" />
    <!--
      Source generator: emits AOT-safe ViewModelMetadata for every TViewModel used in
      PageViewBase<T> / PageEditBase<T> in the consuming assembly. Referenced as an
      analyzer so consumers get the generator automatically via NuGet (see PackagePath
      in the generator's csproj). ReferenceOutputAssembly=false prevents the generator
      DLL from being shipped as a runtime dependency.
    -->
    <ProjectReference Include="..\Zonit.Extensions.Website.SourceGenerators\Zonit.Extensions.Website.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="PublishTrimmed;PublishAot;TargetFramework" />
  </ItemGroup>

  <!--
    The generator DLL is packed into analyzers/dotnet/cs by the shared
    ZonitPackAnalyzerFromProjectReference target in ../Directory.Build.targets. The previous
    local target guarded the hardcoded bin path with Condition="Exists(…)", which meant a
    missing DLL shipped a package with no analyzer and no error — the shared target resolves
    the path from the ProjectReference and fails the build instead.
  -->
</Project>