@*
    Single host component that drives the prerender → interactive state handoff.
    Place it ONCE in your root App.razor (inside <body>, before <Routes/>). The
    framework's DashboardApp.razor already includes it.

    Lifecycle:
      • SSR pass         : every IPersistentStateProvider.RegisterPersist(state) is
                           called; the bridge installs its own RegisterOnPersisting
                           callback using its concrete generic type (.NET 10's
                           PersistAsJson<T> has no Type overload, so the bridge —
                           not the aggregator — knows the T).
      • Interactive pass : every IPersistentStateProvider.Restore(state) is called;
                           the bridge calls TryTakeFromJson<T> and re-seeds its
                           scoped repository before the page body renders.

    Why a component (not a hosted service / circuit handler):
      • PersistentComponentState is a component-scoped service. RegisterOnPersisting
        returns a subscription handle whose semantics are tied to the component's
        lifetime — circuit handlers can't see PersistentComponentState at all.
      • A single component placed in App.razor renders on BOTH SSR and interactive,
        so the same code path serves both ends of the round trip.

    Lifetime: subscriptions are disposed on component teardown so a hot-reload
    doesn't stack callbacks (each reload would otherwise install new bridges +
    leave the old ones registered → state captured twice).

    Diagnostics: when the runtime cannot serialise persistent state at all
    (HydrationSerialization.IsAvailable == false — any PublishTrimmed publish), every
    bridge no-ops. That loss is invisible from the outside — the app renders anonymous
    with default culture and looks healthy — so this component reports it here, once,
    instead of leaving five silent returns. HydrationOptions decides how.
*@
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@namespace Zonit.Extensions.Website.Hydration
@implements IDisposable
@inject PersistentComponentState State
@inject IEnumerable<IPersistentStateProvider> Bridges
@inject ILogger<WebsiteHydrator> Logger
@inject IServiceProvider Services

@code {
    // Subscription handles returned by each bridge's RegisterPersist call.
    // Stored so they can be released on Dispose.
    private readonly List<PersistingComponentStateSubscription> _subscriptions = new();

    protected override void OnInitialized()
    {
        // Report BEFORE wiring anything: under Throw the app must fail here rather than
        // render a page whose scoped state silently never arrives.
        if (!HydrationSerialization.IsAvailable)
            HydrationSerialization.ReportUnavailable(Bridges, Logger, ResolveBehavior());

        foreach (var bridge in Bridges)
        {
            // Restore first — interactive circuit reads the SSR snapshot before
            // the page body initialises, so every @inject in a Razor component
            // sees a fully populated scoped repository on its very first render.
            bridge.Restore(State);

            // Then wire SSR persisting — bridge installs its own RegisterOnPersisting
            // hook with its known generic T (since PersistentComponentState has no
            // Type-accepting overload in .NET 10).
            _subscriptions.Add(bridge.RegisterPersist(State));
        }
    }

    // Resolved through IServiceProvider rather than [Inject]ed: HydrationOptions is opt-in
    // configuration, and a host that never calls Configure<HydrationOptions>() must still be
    // able to render this component. GetService on the open generic IOptions<> is null only
    // when the options infrastructure itself is absent, and the default is what we want then.
    private HydrationUnavailableBehavior ResolveBehavior()
        => Services.GetService<IOptions<HydrationOptions>>()?.Value.WhenSerializationUnavailable
           ?? new HydrationOptions().WhenSerializationUnavailable;

    public void Dispose()
    {
        foreach (var sub in _subscriptions) sub.Dispose();
        _subscriptions.Clear();
    }
}
