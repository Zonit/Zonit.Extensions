<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Per-domain tenant identity and settings for Zonit applications: ITenantSource (the data adapter you implement), the scoped ITenantRepository/ITenantProvider pair, plugin-aware Setting&lt;T&gt; models, and a source generator that gives every setting a strongly-typed accessor. Framework-agnostic: no ASP.NET Core dependency and no middleware here. Built on top of Zonit.Extensions value objects.</Description>
    <PackageTags>Zonit;Extensions;Tenants;Settings;MultiTenancy;Plugins</PackageTags>
  </PropertyGroup>

  <!--
    Framework-agnostic core. The web glue (TenantMiddleware) lives in
    Zonit.Extensions.Website which is the only assembly with a FrameworkReference
    to Microsoft.AspNetCore.App. AddWebsite()/UseWebsite() wires it transparently.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!--
      Abstractions only, and still framework-agnostic: this pulls no provider, no configuration
      and no hosting. TenantService takes ILogger<T> as an OPTIONAL constructor dependency, so a
      host without a logging provider registered keeps resolving ITenantProvider. It buys the
      one thing OnSettingHydrationFailed could never give on its own — a corrupt tenant blob
      showing up in the logs of a host that never knew to subscribe.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!--
      Abstractions only. Backs the appsettings layer: a setting with no persisted override reads
      Tenants:{key} through plain IConfiguration, so every provider the host registered applies
      (JSON files, environment variables, user secrets, Key Vault) and reload rides the standard
      IChangeToken. IConfiguration is an OPTIONAL dependency of TenantConfigurationSource, so the
      package still composes in a bare ServiceCollection with no host behind it.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zonit.Extensions\Zonit.Extensions.csproj" />
    <!--
      Source generator: emits the `TenantSettings` partial class with one strongly-typed
      property per Setting<T> discovered in the consuming assembly (and its referenced
      assemblies). Shipped as analyzer; the generator DLL is NOT a runtime dependency.
    -->
    <ProjectReference Include="..\Zonit.Extensions.Tenants.SourceGenerators\Zonit.Extensions.Tenants.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="PublishTrimmed;PublishAot;TargetFramework" />
  </ItemGroup>

  <!--
    The generator DLL is packed into analyzers/dotnet/cs by the shared
    ZonitPackAnalyzerFromProjectReference target in ../Directory.Build.targets, which resolves
    the path from the ProjectReference above instead of hardcoding bin/$(Configuration)/….
  -->
</Project>
