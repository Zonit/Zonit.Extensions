<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Organization (tenant / workspace) services for Zonit applications. Provides IWorkspaceProvider (the active organization as a read-only Organization value object), IWorkspaceManager (per-scope workspace state and organization switching) and IOrganizationSource, the contract your app implements to supply the data. Framework-agnostic: no HttpContext and no middleware here - the ASP.NET Core middleware that hydrates the scope ships in Zonit.Extensions.Website. Built on top of Zonit.Extensions value objects (Organization).</Description>
    <PackageTags>Zonit;Extensions;Organizations;Workspaces;MultiTenancy</PackageTags>
  </PropertyGroup>

  <!--
    Framework-agnostic dependencies — Organizations core only declares contracts and
    a workspace state machine, no HttpContext. WorkspaceMiddleware lives in
    Zonit.Extensions.Website and is wired through UseWebsite().
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zonit.Extensions\Zonit.Extensions.csproj" />
  </ItemGroup>
</Project>
