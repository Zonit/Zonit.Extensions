<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Culture, time-zone and translation services for Zonit applications. Provides ICultureState/ICultureManager (per-scope culture and time zone), ICultureProvider (translation rendering), ITranslationManager and its process-wide registry, ILanguageProvider with 17 built-in languages, and the Translation value object. Framework-agnostic: no HttpContext and no middleware here — the ASP.NET culture middleware lives in Zonit.Extensions.Website. Built on the Culture and TimeZone value objects from Zonit.Extensions.</Description>
    <PackageTags>Zonit;Extensions;Cultures;Translation;i18n;Localization;Globalization;TimeZone</PackageTags>
  </PropertyGroup>

  <!--
    Framework-agnostic dependencies only — Cultures core has no ASP.NET surface.
    Web-only pieces (CultureMiddleware, the CultureStateBridge prerender bridge driven by
    <WebsiteHydrator/>, and the T()/TM() helpers on ExtensionsBase) live in
    Zonit.Extensions.Website and are wired by AddWebsite()/UseWebsite().
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zonit.Extensions\Zonit.Extensions.csproj" />
  </ItemGroup>
</Project>
