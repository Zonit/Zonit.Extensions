<Project>

  <!--
    Per-package entry point for Zonit.Extensions.Website.Sitemaps. NuGet auto-imports
    buildTransitive/<PackageId>.targets, so this file runs for every consumer that installs this
    package directly or transitively.

    It contributes ONLY this package's documentation to the shared installer. Item groups from
    every installed Zonit.Extensions.* package accumulate before any target runs, so the consumer
    ends up with docs for exactly what they installed - see Zonit.Extensions.Instructions.targets.
  -->

  <ItemGroup>
    <ZonitExtDocRoot Include="$(MSBuildThisFileDirectory)..\Instruction\extensions\sitemaps">
      <Area>sitemaps</Area>
    </ZonitExtDocRoot>
  </ItemGroup>

  <ItemGroup>
    <ZonitExtDoc Include="sitemaps">
      <Area>sitemaps</Area>
      <Summary>Sitemap generation: ISitemapSource registered by the owning area, per-culture expansion with hreflang, size limits, the index and caching.</Summary>
      <Glob>**/*Sitemap*.cs</Glob>
      <SourceFile>$(MSBuildThisFileDirectory)..\Instruction\extensions\sitemaps\sitemaps.md</SourceFile>
    </ZonitExtDoc>
  </ItemGroup>

  <!--
    Guard the IMPORT, not the target - see the comment in Zonit.Extensions.Website.targets for
    why every package ships an identical installer body but only the first import runs it.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Zonit.Extensions.Instructions.targets"
          Condition="'$(_ZonitExtInstallerSeen)' != 'true'" />

</Project>
